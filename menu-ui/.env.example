# Bu dosyayı `.env` adıyla kopyalayın. Değerler BUILD sırasında koda gömülür.

# PixMenu API kökü (sonunda / olmadan). Boşsa aynı origin'deki /api/v1 kullanılır.
VITE_API_URL=https://pixmenu.com/api/v1

# Restoranın slug'ı. Doluysa bu build yalnızca o restoranı gösterir (restorana özel kurulum, geliştirme).
# Boşsa restoran tarayıcıdaki adresten çözülür: sirketadi.pixmenu.com veya menu.sirketadi.com
VITE_RESTAURANT=
