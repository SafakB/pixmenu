# PixMenu menu-ui — Apache (dist/ kökü)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Var olan dosya/dizin olduğu gibi sunulur.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA: /subeadi gibi diğer tüm yollar index.html'e düşer (yönlendirmeyi vue-router yapar).
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Adları içerik hash'li derleme çıktıları: süresiz önbellek.
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # index.html her zaman yeniden doğrulanır; yeni sürüm hemen yayına girer.
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
