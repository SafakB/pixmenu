{
  "name": "pixmenu-menu-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PixMenu ziyaretçi menüsü (Vue 3 + Vite + Tailwind). Veriyi PixMenu API'sinden (GET /api/v1/site) alır.",
  "scripts": {
